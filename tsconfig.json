{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    "types/**/*.d.ts"
  ],
  "contentMappers": [
    {
      "package": "reylo",
      "extensions": [
        ".sql",
        ".reylo.yaml",
        ".reylo.yml"
      ]
    }
  ]
}

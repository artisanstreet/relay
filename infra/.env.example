# Public deploy inputs (NOT secrets — exact https origins, no paths).
# Copy to `.env` (git-ignored) and fill in. Stage comes from the CLI
# (`--stage` / `$ALCHEMY_STAGE`), never from this file.
#
# Non-prod stages MUST use their own origins (e.g. `.env.preview` with
# `--env-file .env.preview`): reusing prod domains on another stage would
# move the production custom domain onto that stage's Worker. The stack
# also refuses identical Core/Relay origins. See README.md.
AST_CORE_ORIGIN=https://core.example.com
AST_RELAY_ORIGIN=https://relay.example.com

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "declaration": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["alchemy.run.ts", "config.ts", "test/**/*.ts", "scripts/**/*.ts"]
}

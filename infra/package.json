{
  "name": "@artisanstreet/relay-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Artisan Street Relay infrastructure as code (Alchemy v2, isolated from runtime). Production source of truth for Relay Worker + Durable Object deploys.",
  "scripts": {
    "install:clean": "pnpm install --frozen-lockfile",
    "check": "pnpm run typecheck && pnpm run test && pnpm --dir .. run build",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "test": "vp test",
    "plan": "varlock run --inject vars -- alchemy plan",
    "deploy": "varlock run --inject vars -- alchemy deploy",
    "destroy": "alchemy destroy",
    "state:bootstrap": "alchemy state bootstrap --backend cloudflare"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-node": "4.0.6",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@varlock/effect-plugin": "0.1.0",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "typescript": "7.1.0-beta",
    "varlock": "1.23.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "pnpm": {
    "overrides": {
      "vitest@*": "5.0.5"
    }
  }
}

# @defaultRequired=false
# @defaultSensitive=false
# ---

# Local Postgres for the Core-interop harness only. May carry prod creds: sensitive.
# @required
# @sensitive
# @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=postgres://core:core@127.0.0.1:55432/core

# Required at request time (parse_env fails closed); optional here for binding-supplied tests.
# @optional
# @type=url
CORE_JWKS_URL=

# @optional
# @type=url
CORE_ISS=

# @optional
RELAY_AUD=ast-relay

# @optional
GRANT_MAX_TTL_S=300

# @optional
# @type=url
CORE_REVOCATIONS_URL=

# @optional
REVOCATION_POLL_MS=60000

# Exact https portal origin; unset = no CORS headers.
# @optional
# @type=url
RELAY_PORTAL_ORIGIN=
